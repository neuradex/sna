{
  "name": "@sna-sdk/core",
  "version": "0.11.2",
  "description": "HTTP/WebSocket server that wraps Claude Code and Codex as backend processes",
  "type": "module",
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/routes/agent": {
      "source": "./src/server/routes/agent.ts",
      "types": "./dist/server/routes/agent.d.ts",
      "default": "./dist/server/routes/agent.js"
    },
    "./server/routes/chat": {
      "source": "./src/server/routes/chat.ts",
      "types": "./dist/server/routes/chat.d.ts",
      "default": "./dist/server/routes/chat.js"
    },
    "./db/schema": {
      "source": "./src/db/schema.ts",
      "types": "./dist/db/schema.d.ts",
      "default": "./dist/db/schema.js"
    },
    "./providers": {
      "source": "./src/core/providers/index.ts",
      "types": "./dist/core/providers/index.d.ts",
      "default": "./dist/core/providers/index.js"
    },
    "./electron": {
      "source": "./src/electron/index.ts",
      "types": "./dist/electron/index.d.ts",
      "require": "./dist/electron/index.cjs",
      "import": "./dist/electron/index.js",
      "default": "./dist/electron/index.js"
    },
    "./node": {
      "source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "require": "./dist/node/index.cjs",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx --watch src/server/standalone.ts || true",
    "test": "node --import tsx --test test/**/*.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://skills-native.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/neuradex/sna",
    "directory": "packages/core"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "codex",
    "sna",
    "hono",
    "websocket"
  ],
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "hono": "^4.12.7",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11.0.0",
    "langfuse": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "langfuse": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "langfuse": "^3.38.20",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
